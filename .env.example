# Supabase (workout tracker) — real values live in .env.local (gitignored)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# AI chat (ai.pnwoods.com) — Ollama on the home computer behind a Cloudflare Tunnel
OLLAMA_URL=http://localhost:11434
# Cloudflare Access service token; leave empty when pointing at a local Ollama
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Host that is rewritten to the /ai route group (local dev: ai.localhost:3000)
AI_HOST=ai.pnwoods.com
# Protects /api/cron/keepalive; Vercel sends it as "Authorization: Bearer <secret>"
CRON_SECRET=
